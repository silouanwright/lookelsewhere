#!/usr/bin/python3
"""Safely emit a byte-bounded regular file owned by the current user."""

import errno
import os
import stat
import sys


def open_without_symlinks(path: str) -> int:
    """Open an absolute path without following a symlink in any component."""
    if not os.path.isabs(path):
        raise OSError(errno.EINVAL, "path must be absolute")

    parts = [part for part in path.split(os.sep) if part]
    if not parts:
        raise OSError(errno.EISDIR, "path has no filename")

    directory_fd = os.open(
        os.sep,
        os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY,
    )
    try:
        for part in parts[:-1]:
            next_fd = os.open(
                part,
                os.O_RDONLY | os.O_CLOEXEC | os.O_DIRECTORY | os.O_NOFOLLOW,
                dir_fd=directory_fd,
            )
            os.close(directory_fd)
            directory_fd = next_fd

        return os.open(
            parts[-1],
            os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK,
            dir_fd=directory_fd,
        )
    finally:
        os.close(directory_fd)


def main() -> int:
    if len(sys.argv) != 4 or sys.argv[1] != "--max-bytes":
        return 64
    try:
        max_bytes = int(sys.argv[2])
    except ValueError:
        return 64
    if max_bytes < 1:
        return 64

    try:
        fd = open_without_symlinks(sys.argv[3])
    except FileNotFoundError:
        return 0
    except OSError as error:
        return 66 if error.errno in (errno.ELOOP, errno.ENXIO) else 68

    try:
        metadata = os.fstat(fd)
        if not stat.S_ISREG(metadata.st_mode):
            return 66
        if metadata.st_uid != os.getuid():
            return 67

        payload = bytearray()
        while len(payload) <= max_bytes:
            chunk = os.read(fd, min(16 * 1024, max_bytes + 1 - len(payload)))
            if not chunk:
                break
            payload.extend(chunk)
        if len(payload) > max_bytes:
            return 65
        sys.stdout.buffer.write(payload)
        return 0
    except OSError:
        return 68
    finally:
        os.close(fd)


if __name__ == "__main__":
    raise SystemExit(main())
