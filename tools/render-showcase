#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
surface=panel
output=
radius=0
pattern=off
forward=()

usage() {
  cat <<'EOF'
Usage: tools/render-showcase [options] [theme-slug ...]

Options:
  --surface panel|fullscreen  Surface to render (default: panel)
  --output FILE               Output PNG
  --columns N                 Grid columns (default: 3)
  --density N                 Output pixel density (default: 2)
  --size WIDTHxHEIGHT         Fullscreen logical size (default: 1920x1080)
  --radius N                  Panel corner radius (default: 0)
  --pattern NAME              Optional panel pattern (default: off)
EOF
}

while (($#)); do
  case "$1" in
    --surface) surface=$2; shift 2 ;;
    --output) output=$2; shift 2 ;;
    --radius) radius=$2; shift 2 ;;
    --pattern) pattern=$2; shift 2 ;;
    --columns|--density|--size) forward+=("$1" "$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) forward+=("$1"); shift ;;
  esac
done

[[ $surface == panel || $surface == fullscreen ]] || { echo "Invalid surface: $surface" >&2; exit 2; }
[[ $radius =~ ^[0-9]+$ ]] || { echo "Radius must be a non-negative integer" >&2; exit 2; }
output=${output:-"$repo/docs/assets/theme-${surface}-grid.png"}

export LOOKELSEWHERE_SHOWCASE_SURFACE=$surface
export LOOKELSEWHERE_SHOWCASE_RADIUS=$radius
export LOOKELSEWHERE_SHOWCASE_PATTERN=$pattern

exec "$repo/vendor/qmlpack/oma-showcase/bin/oma-showcase" \
  --project "$repo" \
  --preview "$repo/tools/showcase/Showcase.qml" \
  --output "$output" \
  "${forward[@]}"
