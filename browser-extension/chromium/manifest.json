{
  "manifest_version": 3,
  "name": "LookElsewhere Browser Context",
  "description": "Provides optional, privacy-safe browser video context to LookElsewhere.",
  "version": "0.1.0",
  "key": "",
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["model.js", "content.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}
