#!/usr/bin/env bash
set -euo pipefail

package_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
project=
preview=
output=
columns=3
density=2
width=1920
height=1080
themes=()

usage() {
  cat <<'EOF'
Usage: oma-showcase --project DIR --preview FILE --output FILE [options] [theme ...]

Options:
  --columns N          Grid columns (default: 3)
  --density N          Output pixel density (default: 2)
  --size WIDTHxHEIGHT  Preview logical size (default: 1920x1080)

Themes default to six common Omarchy themes. User themes are preferred over
stock themes. The preview receives OMA_SHOWCASE_WIDTH, OMA_SHOWCASE_HEIGHT,
OMA_SHOWCASE_BACKGROUND, and OMA_SHOWCASE_THEME in its environment.
EOF
}

while (($#)); do
  case "$1" in
    --project) project=$2; shift 2 ;;
    --preview) preview=$2; shift 2 ;;
    --output) output=$2; shift 2 ;;
    --columns) columns=$2; shift 2 ;;
    --density) density=$2; shift 2 ;;
    --size) width=${2%x*}; height=${2#*x}; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) themes+=("$1"); shift ;;
  esac
done

[[ -d $project ]] || { echo "--project must be a directory" >&2; exit 2; }
[[ -f $preview ]] || { echo "--preview must be a QML file" >&2; exit 2; }
[[ -n $output ]] || { echo "--output is required" >&2; exit 2; }
[[ $columns =~ ^[1-9][0-9]*$ ]] || { echo "Columns must be positive" >&2; exit 2; }
[[ $density =~ ^[1-9][0-9]*([.][0-9]+)?$ ]] || { echo "Density must be positive" >&2; exit 2; }
[[ $width =~ ^[1-9][0-9]*$ && $height =~ ^[1-9][0-9]*$ ]] || { echo "Size must be WIDTHxHEIGHT" >&2; exit 2; }
command -v quickshell >/dev/null
command -v magick >/dev/null

if ((${#themes[@]} == 0)); then
  themes=(catppuccin-latte everforest gruvbox nord osaka-jade tokyo-night)
fi
mkdir -p "$(dirname "$output")"

render_root=$(mktemp -d /tmp/oma-showcase.XXXXXX)
capture_home=$(mktemp -d /tmp/oma-showcase-home.XXXXXX)
cleanup() {
  find "$render_root" -depth -delete 2>/dev/null || true
  find "$capture_home" -depth -delete 2>/dev/null || true
}
trap cleanup EXIT

mkdir -p "$capture_home/.local/state/omarchy/current" "$capture_home/.config"
ln -s /usr/share/omarchy/shell/Commons "$render_root/Commons"
ln -s /usr/share/omarchy/shell/Ui "$render_root/Ui"
ln -s "$project" "$render_root/Project"
cp "$preview" "$render_root/Preview.qml"
cp "$package_root/qml/Capture.qml" "$render_root/shell.qml"
if [[ -e "$HOME/.config/fontconfig" ]]; then
  ln -s "$HOME/.config/fontconfig" "$capture_home/.config/fontconfig"
fi
if [[ -e "$HOME/.config/omarchy/shell.toml" ]]; then
  mkdir -p "$capture_home/.config/omarchy"
  ln -s "$HOME/.config/omarchy/shell.toml" "$capture_home/.config/omarchy/shell.toml"
fi

tiles=()
for theme in "${themes[@]}"; do
  theme_dir=
  for candidate in "$HOME/.config/omarchy/themes/$theme" "/usr/share/omarchy/themes/$theme"; do
    if [[ -d $candidate ]]; then theme_dir=$candidate; break; fi
  done
  [[ -n $theme_dir ]] || { echo "Theme not found: $theme" >&2; exit 2; }

  ln -sfn "$theme_dir" "$capture_home/.local/state/omarchy/current/theme"
  tile="$render_root/$theme.png"
  log="$render_root/$theme.log"
  background=$(find "$theme_dir/backgrounds" -maxdepth 1 -type f 2>/dev/null | sort | head -n 1 || true)
  HOME="$capture_home" \
  QT_QPA_PLATFORM=offscreen \
  QSG_RHI_BACKEND=software \
  OMA_SHOWCASE_OUTPUT="$tile" \
  OMA_SHOWCASE_BACKGROUND="$background" \
  OMA_SHOWCASE_THEME="$theme" \
  OMA_SHOWCASE_WIDTH="$width" \
  OMA_SHOWCASE_HEIGHT="$height" \
  OMA_SHOWCASE_DENSITY="$density" \
    timeout 15 quickshell -p "$render_root" >"$log" 2>&1 || {
      cat "$log" >&2
      echo "Render failed: $theme" >&2
      exit 1
    }
  [[ -s $tile ]] || { echo "Render failed: $theme" >&2; exit 1; }
  tiles+=("$tile")
  echo "Rendered $theme"
done

grid_columns=$((columns < ${#tiles[@]} ? columns : ${#tiles[@]}))
magick montage "${tiles[@]}" -tile "${grid_columns}x" -geometry +0+0 -background none "$output"
echo "$output"
